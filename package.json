      "immutable": ">=5.1.5",
      "lodash": ">=4.18.0",
      "minimatch": ">=10.2.3",
      "picomatch": ">=4.0.4",
      "undici": ">=7.24.0",
      "yaml": ">=2.8.3",
      "axios@<=0.30.2": ">=0.30.3",
      "brace-expansion@<1.1.13": ">=1.1.13",
